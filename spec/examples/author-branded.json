{
  "$schema": "../desktop-switcher-appearance.schema.json",
  "manifestVersion": "0.1",
  "name": "Author branded",
  "description": "Example of a distinctive app-supplied border, restrained tint, icon, and local artwork.",
  "layers": [
    {
      "id": "accent-border",
      "type": "border",
      "color": "#7A5CFF",
      "width": "medium",
      "cornerRadius": "system"
    },
    {
      "id": "accent-tint",
      "type": "tint",
      "color": "#7A5CFF",
      "opacity": 0.10
    },
    {
      "id": "brand-art",
      "type": "image",
      "resource": "DesktopSwitcherAppearance/watermark.png",
      "placement": "bottomTrailing",
      "contentMode": "fit",
      "opacity": 0.20,
      "blendMode": "sourceOver"
    },
    {
      "id": "app-icon",
      "type": "icon",
      "source": "bundleIcon",
      "placement": "topTrailing",
      "size": "large",
      "background": "material"
    },
    {
      "id": "app-title",
      "type": "text",
      "source": "appTitle",
      "placement": "bottomLeading",
      "size": "medium",
      "weight": "semibold",
      "background": "material",
      "maxLines": 1
    }
  ]
}
