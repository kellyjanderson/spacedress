{
  "$schema": "../desktop-switcher-appearance.schema.json",
  "manifestVersion": "0.1",
  "name": "Split-friendly identity",
  "description": "Uses participant-local treatment that remains legible when clipped to one region of a multi-participant switcher item.",
  "layers": [
    {
      "id": "split-border",
      "type": "border",
      "contexts": ["split"],
      "color": "#4E9AFF",
      "width": "thin"
    },
    {
      "id": "app-icon",
      "type": "icon",
      "source": "bundleIcon",
      "placement": "topLeading",
      "size": "large",
      "background": "material"
    },
    {
      "id": "document-title",
      "type": "text",
      "source": "documentTitle",
      "placement": "bottomLeading",
      "size": "small",
      "weight": "medium",
      "background": "scrim",
      "maxLines": 1
    }
  ]
}
